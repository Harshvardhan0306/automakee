('Enterprise Plan', 'For growing teams and businesses', 6000, 5400, ARRAY['Everything in Basic Plan', 'Advanced AI customization', 'Multi-platform support', 'Priority support', 'Unlimited social accounts', 'Custom integrations', 'Dedicated account manager'], false, 'Contact Sales');

-- Create a table for user subscriptions
CREATE TABLE public.user_subscriptions (
  id UUID NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  plan_id UUID NOT NULL REFERENCES public.pricing_plans(id) ON DELETE CASCADE,
  start_date TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT now(),
  end_date TIMESTAMP WITH TIME ZONE,
  payment_status TEXT NOT NULL DEFAULT 'pending',
  payment_id TEXT,
  is_active BOOLEAN NOT NULL DEFAULT false,
  billing_cycle TEXT NOT NULL DEFAULT 'monthly',
  created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT now(),
  updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT now()
);

-- Enable Row Level Security (RLS)
ALTER TABLE public.pricing_plans ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.user_subscriptions ENABLE ROW LEVEL SECURITY;

-- Create policy that allows all users to view pricing plans
CREATE POLICY "Anyone can view pricing plans" 
  ON public.pricing_plans 
  FOR SELECT 
  USING (true);

-- Create policy that allows only admins to insert, update, delete pricing plans
CREATE POLICY "Only admins can insert pricing plans" 
  ON public.pricing_plans 
  FOR INSERT 
  WITH CHECK ((SELECT is_admin FROM public.profiles WHERE id = auth.uid()));

CREATE POLICY "Only admins can update pricing plans" 
  ON public.pricing_plans 
  FOR UPDATE 
  USING ((SELECT is_admin FROM public.profiles WHERE id = auth.uid()));

CREATE POLICY "Only admins can delete pricing plans" 
  ON public.pricing_plans 
  FOR DELETE 
  USING ((SELECT is_admin FROM public.profiles WHERE id = auth.uid()));

-- Create policies for user subscriptions
CREATE POLICY "Users can view their own subscriptions" 
  ON public.user_subscriptions 
  FOR SELECT 
  USING (auth.uid() = user_id OR (SELECT is_admin FROM public.profiles WHERE id = auth.uid()));

CREATE POLICY "Users can insert their own subscriptions" 
  ON public.user_subscriptions 
  FOR INSERT 
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "Users can update their own subscriptions" 
  ON public.user_subscriptions 
  FOR UPDATE 
  USING (auth.uid() = user_id OR (SELECT is_admin FROM public.profiles WHERE id = auth.uid()));

CREATE POLICY "Only admins can delete subscriptions" 
  ON public.user_subscriptions 
  FOR DELETE 
  USING ((SELECT is_admin FROM public.profiles WHERE id = auth.uid()));




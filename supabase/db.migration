-- Create a function to delete pending subscriptions older than 1 day
CREATE OR REPLACE FUNCTION delete_pending_subscriptions()
RETURNS void
LANGUAGE plpgsql
AS $$
BEGIN
  DELETE FROM public.user_subscriptions
  WHERE payment_status = 'pending'
  AND created_at < NOW() - INTERVAL '1 day';
END;
$$;

